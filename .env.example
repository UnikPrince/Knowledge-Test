# .env.example
# Copy this file to .env and fill in your actual values

# ============================================
# Google AI Configuration
# ============================================
GOOGLE_API_KEY=sk-proj-your-api-key-here
GOOGLE_MODEL_ID=gemini-2.0-flash

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=interview_simulator
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# ============================================
# Server Configuration
# ============================================
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api

# ============================================
# PDF Processing Configuration
# ============================================
PDF_CHUNK_SIZE=1000
PDF_CHUNK_OVERLAP=200
PDF_MAX_FILE_SIZE_MB=50

# ============================================
# RAG Configuration
# ============================================
RAG_SIMILARITY_THRESHOLD=0.7
RAG_TOP_K_RESULTS=5
EMBEDDING_MODEL=textembedding-gecko

# ============================================
# Interview Configuration
# ============================================
INTERVIEW_MAX_QUESTIONS=10
INTERVIEW_DIFFICULTY_ADAPTIVE=true
INTERVIEW_FOLLOW_UP_ENABLED=true

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
